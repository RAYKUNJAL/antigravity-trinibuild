# TriniBuild Environment Variables

# =====================================================
# Supabase Configuration
# =====================================================
VITE_SUPABASE_URL=https://cdprbbyptjdntcrhmwxf.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =====================================================
# Payment Methods (Trinidad & Tobago)
# =====================================================

# Paid card rail is not live on this origin. Do not invent a PayPal client.

# WiPay (Coming Soon - Trinidad & Tobago)
# VITE_WIPAY_MERCHANT_ID=your_wipay_merchant_id
# WIPAY_API_KEY=your_wipay_api_key

# Trinidad Bank Transfer (Coming Soon)
# VITE_TTBANK_ACCOUNT=your_business_account_number
# VITE_TTBANK_NAME=your_bank_name

# =====================================================
# Google Maps (For Ride Tracking)
# =====================================================
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key

# =====================================================
# Monitoring & Analytics
# =====================================================

# Sentry Error Monitoring
VITE_SENTRY_DSN=your_sentry_dsn

# Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# =====================================================
# App Configuration
# =====================================================
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production
VITE_APP_NAME=TriniBuild

# =====================================================
# AI & Content Generation
# =====================================================

# OpenAI (Required for AI features)
# Get key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-proj-your_openai_key_here
VITE_OPENAI_ORG_ID=org-your_org_id_here

# =====================================================
# Email & SMS (Optional)
# =====================================================

# SendGrid for emails
SENDGRID_API_KEY=your_sendgrid_key

# Listmonk (Email Marketing - Self-hosted)
VITE_LISTMONK_API_KEY=your_listmonk_api_key
VITE_LISTMONK_URL=https://listmonk.yourdomain.com

# Twilio for SMS
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1868XXXXXXX

# =====================================================
# Social Media (Optional)
# =====================================================
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_INSTAGRAM_TOKEN=your_instagram_token

# =====================================================
# Notes
# =====================================================
# - Never commit this file to Git (.env is in .gitignore)
# - Use .env.local for local development
# - Use environment variables in hosting platform for production
# - PayPal and COD are available now
# - WiPay and Trinidad Bank Transfer coming soon


# =====================================================
# Juvay fees & Wam pass-through (source defaults)
# Wam figures: published rate as of 2026-11-12 — confirm with Wam.
# Volume discounts unpublished. Card settles T+2; wallet instant; bank payout TT$0.
# =====================================================
JUVAY_FEE_BPS_FREE=450
JUVAY_FEE_BPS_PREMIUM=250
JUVAY_FEE_CAP_CENTS=2500
WAM_CARD_PCT_BPS=300
WAM_CARD_FLAT_CENTS=150
WAM_WALLET_PCT_BPS=200
WAM_WALLET_FLAT_CENTS=0
# buyer (default) | seller | split — who pays the TT$1.50 card flat
WAM_CARD_FLAT_PAYER=buyer
# COD buyer-paid handling fee — proposal, not a Juvay commission
COD_HANDLING_FEE_CENTS_DEFAULT=1000
# Promoted listings stub. Keep false; no sell UI ships while this is off.
ADS_ENABLED=false

# Premium monthly plan offer (TT$49 intro / 3 months, then TT$79). Buy button and
# POST /api/premium/checkout stay off until this is true AND a real pay path is proven.
# Default false. A charge does not auto-upgrade a plan.
PREMIUM_CHECKOUT_ENABLED=false

# =====================================================
# Live tracking (shared: route, delivery, visit)
# =====================================================
# Browser Google Maps JavaScript API. SAME name as the "For Ride Tracking"
# key already listed above: VITE_GOOGLE_MAPS_API_KEY. Do not invent a second
# browser key name. Restrict that key by HTTP referrer (https://juvay.app/*
# and http://localhost:*). Enable "Maps JavaScript API".
# If the key is missing, invalid, or the loader errors — including the
# "For development purposes only" watermark — the UI falls back to OSM/Leaflet.

# Server-only Routes API key for traffic-aware ETAs. Prefer a separate key
# restricted by server IP. If unset, the server falls back to
# VITE_GOOGLE_MAPS_API_KEY — that key must have "Routes API" enabled.
# NEVER prefix this with VITE_ (it must not reach the browser bundle).
# GOOGLE_MAPS_SERVER_KEY=your_server_routes_key

# Seller-side job creation is paid (default on). Customer /track pages stay free.
# TRACKING_REQUIRE_PAID=true
# Comma list of plan slugs that unlock creation. Default treats legacy
# pro/starter/business slugs as Premium. Final plans are Free + Premium only.
# TRACKING_PLAN_TIERS=premium,pro,starter,business
# Extra vehicles beyond the 1 included with Premium: stores.tracking_extra_vehicles.
# The monthly add-on price is services/juvayPlans.ts TRACKING_EXTRA_VEHICLE_PRICE_TTD.

# When Google Routes returns 403 or any error, ETA is hidden unless this is true.
# Default false. When there is no server key at all, a haversine approx (labeled
# "approx") is used instead.
# ETA_APPROX_FALLBACK=false

# Optional tuning (defaults shown).
# TRACKING_ASSUMED_SPEED_KMH=30
# TRACKING_ROAD_FACTOR=1.4
# TRACKING_LIVE_SECONDS=120
# TRACKING_HIDE_SECONDS=600
# TRACKING_PURGE_DAYS=7
# TRACKING_MAX_SPEED_KMH=200
# TRACKING_LOCATION_MIN_INTERVAL_MS=4000
# TRACKING_ETA_CACHE_MS=60000
# TRACKING_STORE_PATH=   # local file store for tests; production uses Postgres

